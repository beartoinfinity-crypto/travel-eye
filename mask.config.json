{
  "$comment": "Rules applied by tools/mask.mjs when building docs/ from src/. Add your own personal terms (names, hotels, booking references) to the terms list.",
  "rules": [
    {
      "id": "flight-number",
      "note": "JL 999 → JL ✱✱✱",
      "pattern": "\\b(UO|HX|CX|NH|JL|MM|GK|TR|BR|CI|KE|TG|SQ|MH|FD|SL|JX|IT|JQ|VA|QF|NZ|BA|AF|KL|LH|EK|QR|TK|UA|DL|AA)\\s?([0-9]{2,4})\\b",
      "replace": "$1 ✱✱✱"
    },
    {
      "id": "date-iso",
      "note": "2030-06-14 → 2026-11-✱✱",
      "pattern": "\\b([0-9]{4})-([0-9]{2})-([0-9]{2})\\b",
      "replace": "$1-$2-✱✱"
    },
    {
      "id": "date-dotted",
      "note": "2030.06.14 → 2030.06.✱✱",
      "pattern": "\\b([0-9]{4})\\.([0-9]{2})\\.([0-9]{2})\\b",
      "replace": "$1.$2.✱✱"
    },
    {
      "id": "date-dotted-short",
      "note": "06.14 – 06.21 → 06.✱✱ – 06.✱✱",
      "pattern": "(?<![0-9.])([0-9]{2})\\.([0-9]{2})(?![0-9])",
      "replace": "$1.✱✱"
    },
    {
      "id": "date-slash",
      "note": "06/14 → 06/✱✱",
      "pattern": "\\b(0?[1-9]|1[0-2])/(0?[1-9]|[12][0-9]|3[01])\\b",
      "replace": "$1/✱✱"
    },
    {
      "id": "email",
      "pattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}",
      "replace": "✱✱✱@✱✱✱"
    },
    {
      "id": "phone-hk",
      "note": "9876 5432 / +852 9876-5432. Requires a separator so it cannot hit plain numbers.",
      "pattern": "(?<![\\d+])(?:\\+852[\\s-]?)?[4-9]\\d{3}[\\s-]\\d{4}(?!\\d)",
      "replace": "✱✱✱✱ ✱✱✱✱"
    },
    {
      "id": "phone-intl",
      "pattern": "\\+[0-9]{1,3}[\\s-]?[0-9]{6,12}",
      "replace": "✱✱✱✱ ✱✱✱✱"
    }
  ],
  "terms": [],
  "protect": [
    {
      "$comment": "Copy-paste prompt template: the sample values are fictional and must stay readable.",
      "start": "const PROMPT_TEMPLATE = [",
      "end": "].join('\\n');"
    }
  ]
}
